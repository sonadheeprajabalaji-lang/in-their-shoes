%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: edad3068bd72c46f0a544237e3cec695, type: 3}
  m_Name: Chapter_6
  m_EditorClassIdentifier: Assembly-CSharp::ChapterData
  chapterNumber: 6
  chapterTitle: First Day Back
  weekContext: Month 4, postpartum
  obstacleText: "Guilt and separation anxiety about leaving the baby"
  mainTaskText: "Getting ready for work"
  contentWarningText: This game explores the emotional and physical strain of pregnancy
    and early parenthood. You can exit at any time.
  showMeterIntro: 1
  meterIntroNote: "Move with the arrow keys or WASD, and press E to use things. While getting ready for work, hold E and respond to the prompts: hold SPACE to get herself ready, tap Q to push past the clothes that don't fit, and tap F to quiet the worry loop."
  musicClip: {fileID: 8300000, guid: d07933339b41041bfa75e510f625b122, type: 3}
  ambienceClip: {fileID: 0}
  hourTransitionText: "She's out the door. Part of her isn't."
  partnerHourSeconds: 120
  baseDrain:
    body: 0.02
    mind: 0.035
    feelingLikeAPerson: 0.035
    mask: 0.035
  choices:
  - label: "Sit down and have a moment"
    multipliers:
      body: 1
      mind: 0.6
      feelingLikeAPerson: 1
      mask: 1.4
  - label: "Push on and get out the door"
    multipliers:
      body: 1
      mind: 1.5
      feelingLikeAPerson: 1
      mask: 0.6
  choiceTriggerTaskId: get_ready
  responses:
  - label: "Take over the baby admin"
    nextChapterEase:
      body: 1
      mind: 1
      feelingLikeAPerson: 1
      mask: 1
    impactText: "You buy the nappies and answer the carer about food portions yourself. Tomorrow she can be at work without running the house from her phone."
    learnText: "Australian mothers still do much more of the childcare. In 2020-21, mothers spent an average of 3 hours 34 minutes a day on childcare, compared with 2 hours 19 minutes for fathers."
    helpText: "Own whole areas, like the nappy supply, the carer and drop-offs, including the remembering. COPE suggests talking together about the change and renegotiating tasks like drop-offs and pick-ups."
    sourceText: "ABS, \"How Australians Use Their Time, 2020-21\"; COPE, \"Returning to work\" (cope.org.au)"
  - label: "Ask how she's really feeling"
    nextChapterEase:
      body: 1
      mind: 1
      feelingLikeAPerson: 1
      mask: 1
    impactText: "You say you know leaving the baby was hard, and ask how she really is. She tells you about crying in the car park, and the relief she felt guilty for."
    learnText: "Going back to work can bring sadness, anxiety and guilt about leaving the baby, and for some women relief at a return to normality. Feeling a mix of these is normal."
    helpText: "Ask about her day, not just the job. Make room for both the sadness and the relief, without judging either."
    sourceText: "COPE, \"Returning to work\" (cope.org.au)"
  - label: "Make the evening easier"
    nextChapterEase:
      body: 1
      mind: 1
      feelingLikeAPerson: 1
      mask: 1
    impactText: "You cook dinner and do the bath and bedtime, so the evening isn't a second shift for her."
    learnText: "Nearly 30% of Australian working mothers report strong tension between work and family. Their strain eased when partners took on more of the paid and unpaid work."
    helpText: "Plan the evenings together before her first week back: who cooks, and who does bath and bedtime. Batch cooking and grocery delivery save time on work nights."
    sourceText: "AIFS, \"Persistent work-family strain among Australian mothers\" (Family Matters 86); COPE, \"Returning to work\" (cope.org.au)"
  - label: "Carry on as normal"
    nextChapterEase:
      body: 1
      mind: 1
      feelingLikeAPerson: 1
      mask: 1
    impactText: "Work was fine, she says. You leave it there, and she does bedtime on her own after a full day."
    learnText: "Balancing work and care is still often treated as the mother's job rather than a shared one, and that is part of why work-family strain lasts for many mothers."
    helpText: "Don't wait to be asked. Notice the traces, like the work bag by the door, the note from the carer and the empty nappy box, and take one over tonight."
    sourceText: "AIFS, \"Persistent work-family strain among Australian mothers\" (Family Matters 86)"
  learnHeading: "Going back to work"
  selfHourNotice: "The evening after her first day back. She says: \"Work was fine.\""
