MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: edad3068bd72c46f0a544237e3cec695, type: 3}
  m_Name: Chapter_6
  m_EditorClassIdentifier: Assembly-CSharp::ChapterData
  chapterNumber: 6
  chapterTitle: The Mothers' Group
  weekContext: Month 4, postpartum
  obstacleText: "Low mood and anxiety creeping in: flatness and worry loops"
  mainTaskText: "Hosting the mothers' group at home"
  contentWarningText: This game explores the emotional and physical strain of pregnancy
    and early parenthood. You can exit at any time.
  showMeterIntro: 0
  showContentWarning: 0
  meterIntroNote: "Move with the arrow keys or WASD, and press E to use things. While hosting, hold E and respond to the prompts: hold SPACE to laugh along, tap Q to stop comparing her baby to theirs, and tap F to keep the smile on."
  musicClip: {fileID: 8300000, guid: d07933339b41041bfa75e510f625b122, type: 3}
  ambienceClip: {fileID: 0}
  hourTransitionText: "The last pram leaves. She closes the curtains."
  bodyDrainStory: "She tidied the whole house before anyone arrived, on almost no sleep, and never sat down to eat."
  mindDrainStory: "The worries looped all afternoon: is the baby feeding enough, sleeping enough, behind the others? Every comparison cost her more."
  personDrainStory: "She laughed along all afternoon and felt far away the whole time, as if she were watching herself from across the room."
  maskDrainStory: "She smiled, texted you 'All good!' and kept the living room spotless, so nobody would see how flat she felt."
  partnerHourSeconds: 120
  baseDrain:
    body: 0.02
    mind: 0.03
    feelingLikeAPerson: 0.035
    mask: 0.01
  choices:
  - label: "Step away for a moment"
    multipliers:
      body: 1
      mind: 0.7
      feelingLikeAPerson: 0.8
      mask: 1.4
  - label: "Keep hosting until they leave"
    multipliers:
      body: 1
      mind: 1.4
      feelingLikeAPerson: 1.3
      mask: 0.6
  choiceTriggerTaskId: host_group
  mainTaskHitMeter: 2
  mainTaskHitFraction: 0.5
  responses:
  - label: "Ask how she's really feeling"
    nextChapterEase:
      body: 1
      mind: 1
      feelingLikeAPerson: 1
      mask: 1
    impactText: "You sit with her once the house is quiet and ask how she really is, not how the group went. After a while she says she's felt flat for weeks and can't stop worrying."
    learnText: "Postnatal depression can start at any point in the first year, not just the early weeks. In a study of 10,000 women screened after birth, about 1 in 7 screened positive for depression, and two in three of them also had an anxiety disorder."
    helpText: "Ask open questions at a calm moment and listen without fixing. If flatness or worry lasts more than two weeks, suggest she talks to her GP or child health nurse, and offer to go with her."
    sourceText: "Wisner et al. (2013), JAMA Psychiatry 70(5):490-8"
  - label: "Take over the house for a while"
    nextChapterEase:
      body: 1
      mind: 1
      feelingLikeAPerson: 1
      mask: 1
    impactText: "You take the dishes, the tidying and dinner without being asked. She doesn't have to keep the house looking fine tonight."
    learnText: "Practical support, good communication and relationship satisfaction were each linked with less depression for mothers in a review of 120 published studies."
    helpText: "Take over whole jobs, including noticing they need doing. Low mood makes small tasks feel huge, so fewer of them is real help."
    sourceText: "Pilkington et al. (2015), J Affect Disord 178:165-80"
  - label: "Plan time that's just hers"
    nextChapterEase:
      body: 1
      mind: 1
      feelingLikeAPerson: 1
      mask: 1
    impactText: "You book a Saturday morning where you have the baby and she goes out on her own: a walk, a coffee, a friend who knew her before."
    learnText: "Women interviewed about becoming a mother described first feeling they had lost parts of themselves, before their sense of identity grew to include being a mother."
    helpText: "Make regular time she doesn't have to earn or plan, and protect it. Ask what she misses doing, and help make it happen."
    sourceText: "Laney et al. (2015), Identity 15(2):126-45"
  - label: "Carry on as normal"
    nextChapterEase:
      body: 1
      mind: 1
      feelingLikeAPerson: 1
      mask: 1
    impactText: "She said it went fine, so you leave it there. The bedroom curtains stay drawn, and the worry list on her phone keeps growing."
    learnText: "A review of studies on postpartum depression found many mothers don't tell anyone how they feel, held back by stigma, fear of being judged a bad mother, and not knowing their feelings were depression."
    helpText: "Don't wait for her to bring it up. Notice the traces, like the untouched lunch, the drawn curtains and the 'All good!' text, and gently ask."
    sourceText: "Dennis & Chung-Lee (2006), Birth 33(4):323-31"
  learnHeading: "Around four months after birth"
  selfHourNotice: "The house is quiet again. She texted you 'All good!' earlier. She says: \"It went fine.\""
