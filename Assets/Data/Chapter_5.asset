%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: edad3068bd72c46f0a544237e3cec695, type: 3}
  m_Name: Chapter_5
  m_EditorClassIdentifier: Assembly-CSharp::ChapterData
  chapterNumber: 5
  chapterTitle: Three in the Morning
  weekContext: Week 6, postpartum
  obstacleText: "Severe sleep deprivation"
  mainTaskText: "Settling a crying baby to sleep"
  contentWarningText: This game explores the emotional and physical strain of pregnancy
    and early parenthood. You can exit at any time.
  showMeterIntro: 1
  meterIntroNote: "Move with the arrow keys or WASD, and press E to use things. While settling the baby, hold E and respond to the prompts: hold SPACE to rock and shush, tap Q to stay awake, and tap F to text back friends who are checking in."
  musicClip: {fileID: 8300000, guid: d07933339b41041bfa75e510f625b122, type: 3}
  ambienceClip: {fileID: 0}
  hourTransitionText: "The baby's finally asleep. She can't remember the last time she was."
  partnerHourSeconds: 120
  baseDrain:
    body: 0.03
    mind: 0.04
    feelingLikeAPerson: 0.03
    mask: 0.025
  choices:
  - label: "Put the baby down and step away"
    multipliers:
      body: 1
      mind: 0.6
      feelingLikeAPerson: 1.4
      mask: 1
  - label: "Keep rocking"
    multipliers:
      body: 1.3
      mind: 1.3
      feelingLikeAPerson: 0.7
      mask: 1
  choiceTriggerTaskId: settle_baby
  responses:
  - label: "Give her real sleep"
    nextChapterEase:
      body: 1
      mind: 0.85
      feelingLikeAPerson: 1
      mask: 1
    impactText: "You take the baby for a block of hours and leave her phone in another room. She sleeps without listening for crying.\nNext chapter: her Mind drains more slowly."
    learnText: "A new mother's sleep is broken into short pieces for months. One study found it was about twice as fragmented in the first weeks after birth, and poor sleep after birth is linked with more postnatal depression and anxiety."
    helpText: "Take a whole block of the night, not just one feed, so she gets unbroken sleep. If she's breastfeeding, bring the baby to her, then do the burping, changing and settling yourself."
    sourceText: "Witkowska-Zimny et al. (2024), Int J Womens Health 16:345-71"
  - label: "Ask how she's really feeling"
    nextChapterEase:
      body: 1
      mind: 1
      feelingLikeAPerson: 0.85
      mask: 1
    impactText: "You mention the nurse's number on the fridge and ask if she told the nurse she was fine. She says she's not sure she is.\nNext chapter: Feeling like a person drains more slowly."
    learnText: "Postnatal depression and anxiety affect up to 1 in 5 new mums and up to 1 in 10 new dads. Symptoms can start suddenly after birth, or build gradually over weeks and months."
    helpText: "Name what you've noticed, listen without fixing, and offer to go with her to the GP or child and family health nurse. PANDA's helpline is 1300 726 306. If she talks about harming herself, call Lifeline on 13 11 14 or 000."
    sourceText: "PANDA, \"Postnatal depression: signs and symptoms\" (panda.org.au)"
  - label: "Take jobs off her plate"
    nextChapterEase:
      body: 0.85
      mind: 1
      feelingLikeAPerson: 1
      mask: 1
    impactText: "Sterilising the bottles and the baby laundry become your jobs, not favours. Two fewer things are waiting for her at 11 pm.\nNext chapter: her Body drains more slowly."
    learnText: "Health services advise new parents who are struggling to ask for practical help with shopping, chores and childcare, and to rest as much as they can."
    helpText: "Take over whole jobs rather than single tasks, so she doesn't have to remember or ask. Owning the bottles, the laundry or the shopping takes away the planning as well as the work."
    sourceText: "NHS, \"Postnatal depression\""
  - label: "Carry on as normal"
    nextChapterEase:
      body: 3
      mind: 3
      feelingLikeAPerson: 3
      mask: 3
    impactText: "Everyone's tired, she says. She reheats the same cup of tea for the third time.\nNext chapter: all of her meters drain much faster."
    learnText: "Exhaustion is normal at six weeks, but it can also hide postnatal depression. Struggling to sleep even when there's time to rest is one of its signs."
    helpText: "Don't take \"everyone's tired\" as the end of the conversation. Look at the traces, like cold tea and jobs piling up, then ask, and offer one specific thing you'll take over."
    sourceText: "NHS, \"Postnatal depression\"; PANDA, \"Postnatal depression: signs and symptoms\" (panda.org.au)"
  learnHeading: "Around six weeks after birth"
  selfHourNotice: "She says: \"Everyone's tired.\""
