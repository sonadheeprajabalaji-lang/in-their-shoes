%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: edad3068bd72c46f0a544237e3cec695, type: 3}
  m_Name: Chapter_3
  m_EditorClassIdentifier: Assembly-CSharp::ChapterData
  chapterNumber: 3
  chapterTitle: Packing the Hospital Bag
  weekContext: Week 37, third trimester
  obstacleText: "Broken sleep, heartburn and breathlessness"
  mainTaskText: "Packing the hospital bag and getting the house ready"
  contentWarningText: This game explores the emotional and physical strain of pregnancy
    and early parenthood. You can exit at any time.
  showMeterIntro: 1
  meterIntroNote: "Move with the arrow keys or WASD, and press E to use things. While packing the hospital bag, hold E and respond to the prompts: hold SPACE to catch her breath, tap Q to walk slowly, and tap F to notice the baby's kicks."
  musicClip: {fileID: 8300000, guid: d07933339b41041bfa75e510f625b122, type: 3}
  ambienceClip: {fileID: 0}
  hourTransitionText: "She has to lie down. The bag can wait."
  partnerHourSeconds: 120
  baseDrain:
    body: 0.035
    mind: 0.025
    feelingLikeAPerson: 0.025
    mask: 0.02
  choices:
  - label: "Stop and rest"
    multipliers:
      body: 0.5
      mind: 1.3
      feelingLikeAPerson: 1
      mask: 1
  - label: "Keep packing"
    multipliers:
      body: 1.6
      mind: 0.6
      feelingLikeAPerson: 1
      mask: 1
  choiceTriggerTaskId: hospital_bag
  responses:
  - label: "Make something she can eat"
    nextChapterEase:
      body: 0.85
      mind: 1
      feelingLikeAPerson: 1
      mask: 1
    impactText: "A small, plain dinner, early in the evening. The heartburn settles before bed, and she gets a few more hours of sleep.\nNext chapter: her Body drains more slowly."
    learnText: "Heartburn is common in pregnancy, and more common from 12 weeks on. Eating close to bedtime and lying flat let stomach acid come back up while she sleeps."
    helpText: "Offer small meals more often instead of three big ones, and avoid food in the 3 hours before bed. Go easy on rich, spicy or fatty food and caffeine, and add pillows so her head and shoulders are propped up at night."
    sourceText: "NHS, \"Indigestion and heartburn in pregnancy\""
  - label: "Help her rest"
    nextChapterEase:
      body: 1
      mind: 0.85
      feelingLikeAPerson: 1
      mask: 1
    impactText: "You set up pillows so she can sleep on her side, and you take the evening jobs. She wakes less, and her head is clearer in the morning.\nNext chapter: her Mind drains more slowly."
    learnText: "Late in pregnancy the bump, needing to wee and heartburn all break up her sleep. From 28 weeks, going to sleep on her side rather than her back halves the risk of stillbirth."
    helpText: "Help her get comfortable with a pillow under the bump and one between her knees, and encourage naps when she can. Take over evening chores so she can go to bed earlier."
    sourceText: "HSE Ireland, \"Sleep problems during pregnancy\"; Safer Baby Bundle, \"Sleep on your side\" (saferbaby.org.au)"
  - label: "Plan for after the birth"
    nextChapterEase:
      body: 1
      mind: 1
      feelingLikeAPerson: 0.85
      mask: 1
    impactText: "You agree a visitor plan, freeze some meals and set up a feeding spot with water and snacks. One less thing for her to hold in her head.\nNext chapter: Feeling like a person drains more slowly."
    learnText: "Newborns haven't built up their immune systems yet, so health experts advise limiting close contact with visitors at first, and agreeing the rules as a couple before the baby arrives."
    helpText: "Decide now who visits and when, and who will tell people. Batch-cook and freeze meals, and agree how you'll share nights and chores, so the planning doesn't all fall to her."
    sourceText: "Johns Hopkins Medicine, \"New parents and newborns: are visitors OK?\"; Pilkington et al. (2016), BMC Psychiatry 16:23"
  - label: "Carry on as normal"
    nextChapterEase:
      body: 3
      mind: 3
      feelingLikeAPerson: 3
      mask: 3
    impactText: "She's up at 3 am with heartburn again, on her own, packing the hospital bag in her head.\nNext chapter: all of her meters drain much faster."
    learnText: "Sleep problems affect around 70% of pregnant women and get worse in the third trimester. Poor sleep after birth is linked with more postnatal depression and anxiety."
    helpText: "Notice the signs, like pillows piled on the couch or antacids on the bench. Ask what kept her up, and take one thing off her list today."
    sourceText: "Witkowska-Zimny et al. (2024), Int J Womens Health 16:345-71"
  learnHeading: "In the third trimester"
  selfHourNotice: "She's out of breath on the couch: \"I'm fine, just big.\""
