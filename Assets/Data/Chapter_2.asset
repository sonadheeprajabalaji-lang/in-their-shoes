  m_Script: {fileID: 11500000, guid: edad3068bd72c46f0a544237e3cec695, type: 3}
  m_Name: Chapter_2
  m_EditorClassIdentifier: Assembly-CSharp::ChapterData
  chapterNumber: 2
  chapterTitle: Setting Up the Nursery
  weekContext: Week 22, second trimester
  obstacleText: Worries about the birth and coping as a parent (intrusive 'what if'
    thoughts)
  mainTaskText: Setting up the nursery
  contentWarningText: This game explores the emotional and physical strain of pregnancy
    and early parenthood. You can exit at any time.
  showMeterIntro: 1
  meterIntroNote: 'Move with the arrow keys or WASD, and press E to use things. While
    setting up the nursery, hold E to keep sorting through it while you respond to
    the prompts: tap SPACE to keep sorting, Q to sound excited for mum, and F to
    quiet the what-ifs.'
  musicClip: {fileID: 8300000, guid: d07933339b41041bfa75e510f625b122, type: 3}
  ambienceClip: {fileID: 0}
  hourTransitionText: The what-ifs win, for tonight. She needs to stop.
  partnerHourSeconds: 120
  baseDrain:
    body: 0.02
    mind: 0.035
    feelingLikeAPerson: 0.025
    mask: 0.025
  choices:
  - label: Step away from the nursery
    multipliers:
      body: 1
      mind: 0.5
      feelingLikeAPerson: 1.6
      mask: 1
  - label: Keep sorting through it
    multipliers:
      body: 1
      mind: 1.6
      feelingLikeAPerson: 0.6
      mask: 1
  choiceTriggerTaskId: nursery
  responses:
  - label: Make something she can eat
    nextChapterEase:
      body: 0.85
      mind: 1
      feelingLikeAPerson: 1
      mask: 1
    impactText: '[PLACEHOLDER -- narrative impact + next-chapter effect summary,
      matching Chapter 1''s tone]'
    learnText: '[PLACEHOLDER -- real second-trimester research on antenatal anxiety
      / intrusive thoughts, matching Chapter 1''s citation rigor]'
    helpText: '[PLACEHOLDER -- practical, specific partner guidance]'
    sourceText: '[PLACEHOLDER -- real citations, e.g. Author et al. (Year), Journal]'
  - label: Ask how she's really feeling
    nextChapterEase:
      body: 1
      mind: 1
      feelingLikeAPerson: 0.85
      mask: 1
    impactText: '[PLACEHOLDER]'
    learnText: '[PLACEHOLDER]'
    helpText: '[PLACEHOLDER]'
    sourceText: '[PLACEHOLDER]'
  - label: Clear it away quietly
    nextChapterEase:
      body: 1
      mind: 1
      feelingLikeAPerson: 1
      mask: 1
    impactText: '[PLACEHOLDER]'
    learnText: '[PLACEHOLDER]'
    helpText: '[PLACEHOLDER]'
    sourceText: '[PLACEHOLDER]'
  - label: Carry on as normal
